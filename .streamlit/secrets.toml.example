# Copy this file to secrets.toml and replace each placeholder with your credentials.
GEMINI_API_KEY = "replace-with-your-gemini-api-key"
TWILIO_ACCOUNT_SID = "replace-with-your-twilio-account-sid"
TWILIO_AUTH_TOKEN = "replace-with-your-twilio-auth-token"
TWILIO_WHATSAPP_FROM = "replace-with-your-twilio-whatsapp-sender"
TWILIO_CONTENT_SID = "replace-with-your-twilio-content-template-sid"
